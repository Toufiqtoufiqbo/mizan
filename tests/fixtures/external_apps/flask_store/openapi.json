{
  "openapi": "3.0.3",
  "info": {
    "title": "Store API",
    "version": "1.0.0",
    "description": "A standalone store API. It knows nothing about Mizan."
  },
  "servers": [{ "url": "http://127.0.0.1:8000" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "owner_id": { "type": "string" },
          "sku": { "type": "string" },
          "quantity": { "type": "integer" },
          "status": { "type": "string" },
          "created_at": { "type": "number" }
        }
      },
      "OrderCreate": {
        "type": "object",
        "properties": {
          "sku": { "type": "string", "examples": ["SKU-1"] },
          "quantity": { "type": "integer", "examples": [1] }
        }
      },
      "OrderUpdate": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "examples": ["cancelled"] }
        }
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "examples": ["alice"] },
          "password": { "type": "string", "examples": ["alice-secret"] }
        }
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "summary": "Exchange credentials for a token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Login" } }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/me": {
      "get": {
        "summary": "The current user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create an order",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OrderCreate" } }
          }
        },
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List orders",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "Read an order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "order_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "summary": "Update an order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "order_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OrderUpdate" } }
          }
        },
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "summary": "Delete an order",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "order_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
